{
  "name": "repostem",
  "version": "0.1.1",
  "description": "AI-powered architecture and structural risk analysis for repositories",
  "private": false,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "test:cli": "pnpm --filter @repostem/cli test",
    "test:engine": "pnpm --filter @repostem/engine test",
    "test:engine:watch": "pnpm --filter @repostem/engine test:watch"
  },
  "keywords": [
    "architecture",
    "risk-analysis",
    "dependency-graph",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.6.3",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedwaleed/repostem.git"
  }
}
